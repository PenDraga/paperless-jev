# Optional: fester Schluessel fuer die Verschluesselung der gespeicherten Tokens.
# Ohne Angabe wird beim ersten Start /data/secret.key erzeugt.
PJ_SECRET_KEY=

# Anmeldung fuer die Web-UI. Ohne Passwort ist die Web-UI gesperrt (HTTP 503).
# /hook/* und /health bleiben immer ohne Anmeldung erreichbar.
PJ_ADMIN_USER=admin
PJ_ADMIN_PASSWORD=

# Nur wenn ein vorgeschalteter Login (z. B. Authentik) jede Anfrage schuetzt:
# Web-UI ohne Passwort oeffnen.
#PJ_ALLOW_NO_LOGIN=true

# Hinter einem Reverse Proxy: dessen Adresse oder Netz (kommagetrennt), z. B. 172.19.0.0/16
#PJ_TRUSTED_PROXIES=127.0.0.1

PJ_LOG_LEVEL=INFO
# Sprache fuer Log und Webhook-Antworten: en, de, es, fr, it, nl, pl
#PJ_LOG_LANGUAGE=en

# Optional: fester Schluessel fuer die Verschluesselung der gespeicherten Tokens.
# Ohne Angabe wird beim ersten Start /data/secret.key erzeugt.
PJ_SECRET_KEY=

# Optional: Basic-Auth fuer die Web-UI (hinter Traefik + Authentik nicht noetig).
# /hook/* und /health bleiben immer ohne Basic-Auth erreichbar.
PJ_ADMIN_USER=admin
PJ_ADMIN_PASSWORD=

PJ_LOG_LEVEL=INFO
